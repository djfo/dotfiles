term = xterm-256color

font-family = Iosevka Term
font-size = 18

keybind = cmd+shift+equal=equalize_splits

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

keybind = global:opt+space=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 60%, 50%

copy-on-select = primary
middle-click-action = primary-paste
